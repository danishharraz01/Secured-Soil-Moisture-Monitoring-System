# =====================================================================
# Secured Soil Moisture Monitoring System - environment variables
# Copy to .env and adjust. NEVER commit .env.
# Keys, certificates and passwords are NOT configured here: `npm run setup`
# generates them into certs/, server/keys/, offline-keys/ and CREDENTIALS.txt.
# =====================================================================

NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------- PostgreSQL (docker-compose.yml) ----------
POSTGRES_USER=soil
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=soil
POSTGRES_PORT=5432
DATABASE_URL=postgresql://soil:change-me-local-dev-only@localhost:5432/soil?schema=public
# Separate database used by integration tests (created automatically by the test setup)
TEST_DATABASE_URL=postgresql://soil:change-me-local-dev-only@localhost:5432/soil_test?schema=public

# ---------- API server (HTTPS only, TLS 1.2+) ----------
# 0.0.0.0 lets a phone on the same Wi-Fi reach the server; use 127.0.0.1 to keep it local.
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
# Extra Subject Alternative Names for the self-signed certificate (comma separated)
TLS_EXTRA_SANS=

# ---------- Virtual device (NodeMCU simulator + Virtual Garden page) ----------
DEVICE_PORT=4000
DEVICE_SERVER_URL=https://localhost:8443
# demo = 1 real second is 10 simulated minutes, realtime = 1:1
SIM_SPEED=demo
# Probability (0-1) of a random PIR motion event per simulation tick
MOTION_CHANCE=0.002

# ---------- Syslog collector (RFC 5424 over TLS, RFC 6587 octet counting) ----------
SYSLOG_HOST=localhost
SYSLOG_PORT=6514
# Interface the collector listens on (127.0.0.1 = this machine only)
SYSLOG_BIND_HOST=127.0.0.1
SYSLOG_LOG_FILE=logs/syslog.log

# ---------- Owner / users (used by `npm run setup`) ----------
ADMIN_EMAIL=owner@example.com
VIEWER_EMAIL=viewer@example.com
# E.164 format
ADMIN_PHONE=+60123456789

# ---------- Email (OTP + alerts) ----------
# Leave SMTP_HOST empty to write emails to outbox/email-<time>.txt instead.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS is required (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Soil Monitor <no-reply@example.com>"

# ---------- SMS (GSM module replacement) ----------
# file = write to outbox/sms-<time>.txt (Twilio-ready interface for later)
SMS_PROVIDER=file

# ---------- Output folders ----------
OUTBOX_DIR=outbox
LOGS_DIR=logs

# ---------- Encrypted cloud backup ----------
# local = encrypted files in CLOUD_DIR (S3-ready interface)
BACKUP_PROVIDER=local
CLOUD_DIR=cloud
BACKUP_INTERVAL_MINUTES=10
BACKUP_KEEP=20
