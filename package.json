{
  "name": "secure-soil-iot",
  "version": "3.0.0",
  "description": "Secured soil moisture monitoring and auto-watering system for celery, with a simulated IoT node, mobile app, email OTP, syslog and encrypted cloud backup",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning setup.js",
    "reset": "node --disable-warning=ExperimentalWarning setup.js --reset",
    "syslog": "node tools/syslog-collector.js",
    "server": "node --disable-warning=ExperimentalWarning server/server.js",
    "device": "node device/simulator.js",
    "attack": "node --disable-warning=ExperimentalWarning attacks/attack.js",
    "restore": "node tools/restore-backup.js"
  },
  "optionalDependencies": {
    "nodemailer": "^7.0.0"
  }
}
